{
  "name": "Eclipso",
  "version": "1.5.2",
  "main": "main.js",
  "type": "module",
  "description": "Application Electron pour kiosk d'impression photos avec sélection d'univers graphiques, panier dynamique et paiement",
  "author": {
    "name": "Selfizee",
    "email": "contact@selfizee.fr",
    "url": "https://selfizee.fr/"
  },
  "scripts": {
    "start": "electron .",
    "start:dev": "copy .env.dev .env && electron .",
    "start:prod": "copy .env.prod .env && electron .",
    "dev": "node build.js && electron .",
    "dev:dev": "copy .env.dev .env && node build.js && electron .",
    "dev:prod": "copy .env.prod .env && node build.js && electron .",
    "build": "node build.js",
    "build:dev": "copy .env.dev .env && node build.js",
    "build:prod": "copy .env.prod .env && node build.js",
    "watch": "node build.js --watch",
    "dist": "npm run build && electron-builder --win",
    "dist:dev": "copy .env.dev .env && npm run build && electron-builder --win",
    "dist:prod": "copy .env.prod .env && npm run build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "esbuild": "^0.20.0"
  },
  "build": {
    "appId": "com.printstation.app",
    "productName": "PrintStation",
    "directories": {
      "buildResources": "renderer/assets"
    },
    "files": [
      "main.js",
      "preload.js",
      ".env",
      "services/**/*",
      "renderer/**/*",
      "!renderer/src",
      "renderer/src/photosystem/**/*",
      "node_modules/**/*",
      "renderer/assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "renderer/assets/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PrintStation"
    }
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "sqlite3": "^5.1.7"
  }
}
