# Configuration PrintStation App
# Copier ce fichier en .env et ajuster les valeurs

# ============================================
# API Configuration
# ============================================

# URL de l'API pour la synchronisation des photos
# Format: http://votre-serveur.com/api/checkPhotos
PHOTO_API_URL=http://localhost:8888/printStationServer/api/checkPhotos.php

# ============================================
# Application Settings
# ============================================

# Mode de l'application (development | production)
NODE_ENV=development

# ============================================
# Admin Settings
# ============================================

# Mot de passe admin (à changer en production!)
ADMIN_PASSWORD=admin123

# ============================================
# Database Settings
# ============================================

# Les chemins de base de données sont automatiques selon l'OS:
# - Windows: C:\PrintStationApp\Medias\data.db
# - Mac: ~/Documents/PrintStationApp/Medias/data.db
# - Linux: ~/.PrintStationApp/Medias/data.db

# ============================================
# Sync Settings
# ============================================

# Intervalle de synchronisation en millisecondes (30000 = 30 secondes)
SYNC_INTERVAL_MS=30000

# Timeout pour les requêtes API en millisecondes
SYNC_TIMEOUT_MS=10000

# ============================================
# Notes d'utilisation
# ============================================

# 1. Copier ce fichier:
#    cp .env.example .env
#
# 2. Éditer .env avec vos valeurs
#
# 3. Redémarrer l'application
#
# 4. Ne JAMAIS committer le fichier .env dans Git!

# ============================================
# Exemple de configuration serveur distant
# ============================================

# PHOTO_API_URL=https://votre-domaine.com/api/checkPhotos
# NODE_ENV=production
# ADMIN_PASSWORD=VotreMotDePasseSecurise123!
